{
  "schema_version": 3,
  "name": "tcp-tarpit",
  "display_name": "TCP tarpit",
  "version": "1.0.0",
  "description": "Listens on decoy TCP ports, reports every connection and payload, and holds, echoes or closes the connection.",
  "category": "network",
  "author": "TrueSignal",
  "documentation": "Runs as UID 0 with every capability dropped except NET_BIND_SERVICE (needed for ports below 1024 in host networking; Docker grants added capabilities only to root). Read-only filesystem, no-new-privileges.",
  "image": {
    "repository": "ghcr.io/mahmoudahmed3132/ts-sensor-tcp-tarpit",
    "tag": "1.0.0",
    "digest": "sha256:7edf79dfaee4b8cade7e25ca3c390b69dbbbd8b6819184679c76b8b94363023f",
    "platforms": [
      "linux/amd64"
    ]
  },
  "runtime": {
    "user": "0:0",
    "network_mode": "host",
    "cap_add": [
      "NET_BIND_SERVICE"
    ],
    "memory_mb": 128,
    "listen_ports": [
      {
        "config_key": "TS_PORTS",
        "protocol": "tcp"
      }
    ]
  },
  "config": [
    {
      "name": "TS_PORTS",
      "type": "list",
      "item_type": "port",
      "required": true,
      "description": "TCP ports to listen on",
      "validation": {
        "max_items": 64
      }
    },
    {
      "name": "TS_MODE",
      "type": "enum",
      "default": "hold",
      "description": "hold: keep open and read slowly; echo: echo bytes slowly; close: accept and close",
      "validation": {
        "enum": [
          "hold",
          "echo",
          "close"
        ]
      }
    },
    {
      "name": "TS_MAX_DURATION_SEC",
      "type": "int",
      "default": "600",
      "description": "Maximum connection duration",
      "validation": {
        "min": 1,
        "max": 86400
      }
    },
    {
      "name": "TS_BANNERS",
      "type": "string",
      "description": "Per-port banners: port=banner|port=banner. Write CR, LF, tab and backslash as backslash-r, backslash-n, backslash-t and two backslashes. At most 512 bytes each.",
      "validation": {
        "max_length": 4096
      }
    },
    {
      "name": "TS_MAX_CONNS",
      "type": "int",
      "default": "512",
      "description": "Concurrent connections, all sources",
      "validation": {
        "min": 1,
        "max": 65536
      }
    },
    {
      "name": "TS_MAX_PER_SOURCE",
      "type": "int",
      "default": "16",
      "description": "Concurrent connections per source IP",
      "validation": {
        "min": 1,
        "max": 4096
      }
    },
    {
      "name": "TS_EVENT_COOLDOWN_SEC",
      "type": "int",
      "default": "10",
      "description": "Minimum seconds between events per source and port (suppressed events are counted)",
      "validation": {
        "min": 0,
        "max": 86400
      }
    },
    {
      "name": "TS_DEFAULT_SEVERITY",
      "type": "enum",
      "default": "medium",
      "description": "Default severity",
      "validation": {
        "enum": [
          "info",
          "low",
          "medium",
          "high",
          "critical"
        ]
      }
    }
  ],
  "discovery": {
    "process_names": [
      "sshd",
      "telnetd",
      "vsftpd",
      "proftpd"
    ],
    "listening_ports": [
      22,
      23,
      21
    ],
    "defaults": {
      "TS_PORTS": "free_port(2222)"
    }
  },
  "triggers": [
    {
      "name": "tcp_connection",
      "default_severity": "medium",
      "description": "A TCP connection reached a decoy port"
    },
    {
      "name": "tcp_session_payload",
      "default_severity": "high",
      "description": "The peer sent data before closing (first 2 KiB, escaped)"
    }
  ],
  "compatibility": {
    "hub_major": 3
  }
}
